\subsection{Recipe 9.9: Climate Risk Integration Factor}

\textbf{ESG Climate Transition Risk Factor}
\textbf{Mathematical Foundation:}
\begin{align}
\text{Climate Risk Score:} \quad CRS_i = w_1 \cdot TR_i + w_2 \cdot PR_i + w_3 \cdot PR_i \\
\text{Transition Risk:} \quad TR_i = \beta_{i,climate} \cdot \frac{E_i}{Revenue_i} \\
\text{Physical Risk:} \quad PR_i = \alpha_{i,region} \cdot \text{Exposure}_i \cdot \text{Vulnerability}_i

\subsubsection{Carbon Beta and Emissions Factors}

Carbon beta measures sensitivity to carbon price changes:

\begin{align}
\beta_{carbon,i} &= \frac{\Cov(r_i, r_{carbon})}{\Var(r_{carbon})} \\
\text{where} \quad & r_{carbon} = \Delta \log(\text{carbon price})
\end{align}

\subsubsection{Stranded Assets Valuation}

Discounted cash flow with carbon constraints:

\begin{align}
V &= \sum_{t=1}^T \frac{CF_t}{(1 + r)^t} \cdot \Prob(\text{not stranded at t}) \\
\text{Stranding Probability:} \quad & p_t = 1 - \exp\left( -\lambda \int_0^t \text{carbon intensity}(\tau) d\tau \right)
\end{align}

\subsubsection{ESG Integration in Factor Models}

Augmented Fama-French model with ESG factors:

\[
r_i - r_f = \alpha_i + \beta_{MKT} (r_m - r_f) + \beta_{SMB} SMB + \beta_{HML} HML + \beta_{ESG} ESG + \epsilon_i
\]

\subsubsection{Sustainable Investing Constraints}

Portfolio optimization with ESG constraints:

\begin{align}
\maximize_{\mathbf{w}} \quad & \mathbf{w}^T \boldsymbol{\mu} \\
\subjectto \quad & \mathbf{w}^T \mathbf{1} = 1 \\
& \mathbf{w}^T \boldsymbol{\Sigma} \mathbf{w} \leq \sigma_{target}^2 \\
& ESG(\mathbf{w}) \geq ESG_{min} \\
& \mathbf{w} \geq \mathbf{0}
\end{align}
\end{align}
