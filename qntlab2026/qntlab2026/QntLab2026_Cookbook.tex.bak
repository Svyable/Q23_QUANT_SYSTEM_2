def analyze_factor_balance(factors, weights):
    """Analyze factor category balance in portfolio."""

    # Define factor categories
    categories = {
        'Defensive': ['inv_vol', 'inv_idio', 'inv_down', 'low_corr', 'low_beta'],
        'Liquidity': ['liquidity'],
        'Momentum': ['resid_mom'],
        'Reversal': ['srev'],
        'Technical': ['breakout', 'slope', 'calm_flow']
    

